# Эти значения задаются в Netlify: Project configuration → Environment variables.
# Сам файл .env в интернет не выкладывать.

# SQL-база Postgres (Neon) — строка подключения postgresql://...
DATABASE_URL=
# Токен бота от @BotFather
TG_BOT_TOKEN=
# Ваш личный chat id в Telegram (бот подскажет его по команде /myid)
TG_OWNER_CHAT_ID=
# Любая длинная случайная строка — защищает адрес бота от подделки
TG_WEBHOOK_SECRET=
# Имя бота без @ (например esa_orders_bot)
TG_BOT_USERNAME=
# Реквизиты для оплаты — бот отправит их клиенту ТОЛЬКО после того, как вы примете заказ
PAY_INFO=MBank / Optima по номеру телефона: +996 XXX XXX XXX (Самат Э.)
